{
  "$schema": "https://opencode.ai/config.json",
  "model": "ai-stack/local-fast",
  "default_agent": "build",
  "providers": {
    "ai-stack": {
      "name": "Marcus Local AI Stack",
      "env": ["AI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "{env:AI_API_KEY}"
      },
      "models": {
        "local-fast": {
          "modelID": "local-fast",
          "name": "Qwen3.5-9B (local-fast)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "local-ai": {
        "type": "remote",
        "url": "http://127.0.0.1:8765/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {env:MCP_API_KEY}" },
        "codemode": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 6000 },
    "buffer": 4096
  },
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose down *", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune *", "effect": "deny" }
  ]
}
