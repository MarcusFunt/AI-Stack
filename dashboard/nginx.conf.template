server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 512m;

  # Docker container IPs can change when gateway is recreated. Resolve the
  # service name for each request instead of caching its startup-time address.
  resolver 127.0.0.11 ipv6=off valid=1s;
  resolver_timeout 2s;
  set $gateway_backend http://gateway:8000;
  set $agent_lab_backend http://agent-lab:8000;

  location = /api/events {
    proxy_pass $gateway_backend/events;
    proxy_set_header Authorization "Bearer ${AI_API_KEY}";
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }

  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $gateway_backend;
    proxy_set_header Authorization "Bearer ${AI_API_KEY}";
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }

  # Agent Lab is reachable through the same private dashboard origin. Keep the
  # controller's host-only port private rather than exposing it to the browser.
  location /agent-lab-api/ {
    rewrite ^/agent-lab-api/(.*)$ /$1 break;
    proxy_pass $agent_lab_backend;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}


# Private studio bridges. Host ports are loopback-only; Tailscale Serve can
# expose these listeners to the tailnet without publishing the raw AI apps.
server {
  listen 8188;
  server_name _;
  client_max_body_size 512m;
  resolver 127.0.0.11 ipv6=off valid=1s;
  resolver_timeout 2s;
  set $comfyui_backend http://comfyui:8188;

  location / {
    proxy_pass $comfyui_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}

